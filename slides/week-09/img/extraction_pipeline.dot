// Week 9's extraction_pipeline.png: the steps PDFCorpusAnalyzer runs on each file.
// Build: dot -Tpng -Gdpi=150 extraction_pipeline.dot -o extraction_pipeline.png
digraph pipeline {
  rankdir=TB;
  node [shape=box, style="rounded,filled", fillcolor="#eef3f8", color="#1f4e79",
        fontname="DejaVu Sans", fontsize=15, margin="0.18,0.08", width=3.4];
  edge [color="#1f4e79", arrowsize=0.8];
  discover [label=<<b>Discover</b><br/><font face="DejaVu Sans Mono" point-size="13">os.listdir() → *.pdf</font>>];
  extract  [label=<<b>Extract text</b><br/><font face="DejaVu Sans Mono" point-size="13">page.extract_text()</font>>];
  clean    [label=<<b>Clean</b><br/><font point-size="13">collapse spaces, keep newlines</font>>];
  fields   [label=<<b>Regex fields</b><br/><font face="DejaVu Sans Mono" point-size="13">re.search(...)</font>>];
  frame    [label=<<b>DataFrame</b><br/><font point-size="13">one row per file; errors kept</font>>];
  discover -> extract -> clean -> fields -> frame;
}
